# Core app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32
DATABASE_URL=postgresql://curator:CHANGEME_POSTGRES_PASSWORD@localhost:5437/curator
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD

# Auth
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_AUTH_GOOGLE_ID=your-google-oauth-client-id
# Native iOS Google Sign-In: iOS OAuth client ID, verified as an accepted
# audience alongside AUTH_GOOGLE_ID when validating device idTokens
AUTH_GOOGLE_IOS_CLIENT_ID=

# Optional web Sign in with Apple (Services ID + JWT client secret).
# Not required for native iOS Sign in with Apple below.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=false

# Native iOS Sign in with Apple: the app's Bundle ID / App ID, the audience
# Apple embeds in device identity tokens and server-to-server notifications
AUTH_APPLE_IOS_CLIENT_ID=com.alexradu.curatorai

# Native Android Sign in with Apple: a separate Apple Services ID (created in
# the Apple Developer portal) with a Return URL of
# https://curatorfrc.com/native-auth/apple-callback. Read both client-side
# (to initialize the in-app WebView OAuth flow) and server-side (as an
# accepted audience alongside AUTH_APPLE_IOS_CLIENT_ID above).
NEXT_PUBLIC_AUTH_APPLE_ANDROID_CLIENT_ID=
# NEXT_PUBLIC_ vars are inlined at next build time, even in server code -
# setting/changing this in prod requires a rebuild + redeploy to take effect.

ADMIN_EMAILS=admin@example.com

# AI providers
OPENROUTER_API_KEY=your-openrouter-api-key
# Comma-separated fallback chain, tried left to right. Chat models must support
# tool calling and streaming. Keep at least one paid model last so a free-tier
# 429 does not take chat down.
OPENROUTER_CHAT_MODELS=inclusionai/ling-3.0-flash:free,openai/gpt-oss-20b:free,openai/gpt-4o-mini
OPENROUTER_DESCRIPTION_MODELS=openai/gpt-4o-mini,inclusionai/ling-3.0-flash:free
OPENROUTER_TITLE_MODEL=openai/gpt-4o-mini

# Vector search and document storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=CHANGEME_QDRANT_API_KEY
QDRANT_COLLECTION=frc_docs
MINIO_ENDPOINT=http://localhost:9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGEME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGEME_MINIO_SECRET_KEY
MINIO_BUCKET=curator-docs

# Optional live web search
LANGSEARCH_API_KEY=

# Optional The Blue Alliance MCP integration
TBA_MCP_ENABLED=false
TBA_API_KEY=

# Optional Google Analytics and Search Console verification
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
SENTRY_RELEASE_MANAGEMENT_ENABLED=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional IndexNow
INDEXNOW_KEY=
INDEXNOW_SITE_URL=
INDEXNOW_SUBMIT_ON_START=false
INDEXNOW_SUBMIT_DELAY_MS=5000
